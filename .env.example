# Copy to .env and fill in the values below. Never commit .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Token: https://nocodb.nfdi.de/dashboard/#/account/tokens
# Leave empty to build from the committed static/data.json (no NocoDB access).
# With a token, every build WRITES to NocoDB (see README → "What a build writes").
NOCODB_API_TOKEN=

# Public origin of the site as typed in the browser (Zola link prefix).
# A wrong value breaks every internal link. Changing it requires a rebuild.
BASE_URL=http://localhost:8080

# Host port nginx is published on. Changing it needs no rebuild.
PORT=8080

# ---------------------------------------------------------------------------
# Optional overrides — forwarded to the Docker build and read by ./build.sh
# (defaults match the Integration Dashboard tables)
# ---------------------------------------------------------------------------

# NOCODB_BASE_URL=https://nocodb.nfdi.de
# NOCODB_TABLE_ID=m3zt5vqlyja927x
# NOCODB_USER_STORIES_TABLE_ID=mtq40pxpo5p0jmx
# NOCODB_REF_ENTITIES_TABLE_ID=7v80fm7p5jpa7xj
# NOCODB_PARTNERS_TABLE_ID=pf8ggs9jduxse4x
# NOCODB_PAGE_SIZE=100

# Leave the *_VIEW_ID values unset for full-table access (recommended).
# If set, NocoDB applies that view's filters.
# NOCODB_VIEW_ID=
# NOCODB_USER_STORIES_VIEW_ID=
# NOCODB_REF_ENTITIES_VIEW_ID=
# NOCODB_PARTNERS_VIEW_ID=

# Network tuning for source, news, logo and font downloads
# FETCH_TIMEOUT_MS=60000
# FETCH_RETRIES=2

# ---------------------------------------------------------------------------
# Host-only — used by maintenance scripts run with `node scripts/…`,
# NOT forwarded to the Docker build
# ---------------------------------------------------------------------------

# Zenodo community logos used to fill blank REF_Partners.official_logo
# ZENODO_COMMUNITIES_CSV=../../zenodo-analyzer/communities.csv
