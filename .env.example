# Copy to .env and fill in your token (never commit .env).
# Token: https://nocodb.nfdi.de/dashboard/#/account/tokens

NOCODB_API_TOKEN=

# Optional overrides (defaults match the Integration Dashboard tables)
# NOCODB_BASE_URL=https://nocodb.nfdi.de
# NOCODB_TABLE_ID=m3zt5vqlyja927x
# NOCODB_USER_STORIES_TABLE_ID=mtq40pxpo5p0jmx
# NOCODB_REF_ENTITIES_TABLE_ID=7v80fm7p5jpa7xj
# NOCODB_PAGE_SIZE=100
#
# Leave NOCODB_VIEW_ID / NOCODB_USER_STORIES_VIEW_ID / NOCODB_REF_ENTITIES_VIEW_ID
# unset for full-table access (recommended). If set, NocoDB applies that view's filters.
# NOCODB_VIEW_ID=
# NOCODB_USER_STORIES_VIEW_ID=
# NOCODB_REF_ENTITIES_VIEW_ID=

# If NocoDB column titles differ from CSV headers, map them here:
# NOCODB_FIELD_PROJECT=Project
# NOCODB_FIELD_STATUS=Status

# Docker Compose (nginx serves public/ on host PORT)
# BASE_URL must match the public origin used in the browser (Zola link prefix).
# PORT=8080
# BASE_URL=http://localhost:8080
# Production example:
# BASE_URL=https://dashboard.example.org
