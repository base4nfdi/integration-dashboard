    {
      "source": "ts4nfdi",
      "table": "incubators",
      "id": 101,
      "inc_name": "Terminology Service Suite integration for WissKI authority data enrichment",
      "key_article": "ts-terminology-service-suite-integration-for-wisski-authority-data-enrichment",
      "reasons": [
        "sync:inc_descr"
      ],
      "unresolved_partners": [],
      "partner_ids": [],
      "patch": {
        "inc_descr": "SODa's Semantic Co-Working Space (SCS) provides a cloud environment for deploying WissKI-based research applications. WissKI Barrels are containerised, domain-specific research environments built on WissKI and CIDOC-CRM. Today, each Barrel manages terminology lookups independently – with fragmented provider integrations (GND, Getty, GeoNames, Wikidata) and bespoke UI components. This incubator integrates the TS4NFDI Terminology Service Suite into WissKI's Authority Document module and publishes SODa-maintained controlled vocabularies (e.g. provenance event types, conservation treatment categories) via the API Gateway."
      }
    }
